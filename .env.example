# ─────────────────────────────────────────────────────────────
# TLaaS Environment Configuration  (copy to .env.production)
# Never commit the populated file. Only this .example belongs in git.
# ─────────────────────────────────────────────────────────────

# --- Database (Postgres cache) ---
DB_USER=postgres
DB_PASSWORD=change_me_secure_tlaas_pass
DB_NAME=tlaas_ledger
DATABASE_URL=postgres://postgres:change_me_secure_tlaas_pass@db:5432/tlaas_ledger

# --- API server (validator/server.js) ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
POLL_INTERVAL=15       # seconds between dropzone scans
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Cryptographic keys (KEEP HIGHLY GUARDED — never commit) ---
# Server key that pays the tiny anchor write fee. Funded via Friendbot on Testnet.
SERVER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Deployed contract IDs (populated by deploy.sh in Phase 3) ---
SOROBAN_LEDGER_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOROBAN_GOVERNANCE_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
